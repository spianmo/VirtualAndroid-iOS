new file mode 100644
index 0000000..d920132
--- /dev/null
+++ b/host/VaSnapshot.h
@@ -0,0 +1,40 @@
+// VirtualAndroid: small C API over gfxstream's snapshot machinery, so the
+// embedder glue (libva_gfx) does not need FrameBuffer/RendererImpl headers.
+// Streams are android::base::Stream* passed as void*.
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Waits for the process-cleanup thread to drain (unbounded: run it on a
+// helper thread). Returns 1 if a renderer exists.
+int gfxstream_va_drain_process_cleanup(void);
+// Puts every live render thread into snapshot-save mode (non-blocking).
+void gfxstream_va_pause_render_threads(void);
+// 1 when every render thread finished its snapshot step (save after a
+// pause, or restore after a load) before deadlineUs (getUnixTimeUs clock).
+int gfxstream_va_wait_snapshot_steps(uint64_t deadlineUs);
+// Saves the FrameBuffer into |stream|; texture contents go to textureFile.
+int gfxstream_va_save(void* stream, const char* textureFile, uint64_t* textureBytes);
+// Loads the FrameBuffer; textures load lazily (and in the background) from
+// textureFile, which must stay readable until gfxstream_va_release_texture_loader().
+int gfxstream_va_load(void* stream, const char* textureFile);
+// Waits until every queued SyncThread command ran (trigger-wait results are
+// delivered to the goldfish_sync device). Unbounded: run it on a helper thread.
+void gfxstream_va_drain_sync_thread(void);
+void gfxstream_va_resume_all(void);
+// Re-posts the last posted ColorBuffer (presents it again). 1 on success.
+int gfxstream_va_repost(void);
+size_t gfxstream_va_num_render_threads(void);
+// Before saving again after a load: wait for the background texture loader
+// to restore every texture (it iterates the map a save clears), then drop it.
+void gfxstream_va_finish_texture_loading(void);
+void gfxstream_va_release_texture_loader(void);
+
+#ifdef __cplusplus
+}
+#endif
