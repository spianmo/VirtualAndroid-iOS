@@ -0,0 +1,33 @@
+// VirtualAndroid: iOS replacements for the few MacNative.h helpers that
+// EglOsApi_egl.cpp (EGL-on-EGL over ANGLE) uses. On iOS there is no
+// NSView/CGL; a native window is a CALayer (ANGLE's Metal backend accepts a
+// CALayer/CAMetalLayer as EGLNativeWindowType).
+#include "MacNative.h"
+
+#import <QuartzCore/QuartzCore.h>
+
+void* nsGetLayer(void* nativeWin) { return nativeWin; }
+
+bool nsGetWinDims(void* win, unsigned int* width, unsigned int* height) {
+    if (!win) return false;
+    CALayer* layer = (__bridge CALayer*)win;
+    CGSize size = layer.bounds.size;
+    CGFloat scale = layer.contentsScale;
+    *width = (unsigned int)(size.width * scale);
+    *height = (unsigned int)(size.height * scale);
+    return true;
+}
+
+bool nsCheckColor(void* win, int colorSize) {
+    (void)win;
+    (void)colorSize;
+    return true;
+}
+
+// Host hardware video decode (VideoToolbox -> CGL textures) is macOS/CGL only.
+void nsConvertVideoFrameToNV12Textures(void* context, void* iosurface, int Ytex, int UVtex) {
+    (void)context;
+    (void)iosurface;
+    (void)Ytex;
+    (void)UVtex;
+}
