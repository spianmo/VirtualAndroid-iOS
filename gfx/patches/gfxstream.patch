diff --git a/host/VaSnapshot.cpp b/host/VaSnapshot.cpp
new file mode 100644
index 0000000..ad7ae67
--- /dev/null
+++ b/host/VaSnapshot.cpp
@@ -0,0 +1,109 @@
+// VirtualAndroid: see VaSnapshot.h.
+#include "VaSnapshot.h"
+
+#include <cstdio>
+#include <memory>
+
+#include "FrameBuffer.h"
+#include "RendererImpl.h"
+#include "SyncThread.h"
+#include "aemu/base/files/StdioStream.h"
+#include "host-common/opengles.h"
+#include "snapshot/TextureLoader.h"
+#include "snapshot/TextureSaver.h"
+
+using android::base::StdioStream;
+
+namespace {
+
+gfxstream::RendererImpl* impl() {
+    const auto& r = android_getOpenglesRenderer();
+    return static_cast<gfxstream::RendererImpl*>(r.get());
+}
+
+// Leaked on purpose (may be used by the background loader during exit).
+std::shared_ptr<android::snapshot::TextureLoader>& loaderRef() {
+    static auto* p = new std::shared_ptr<android::snapshot::TextureLoader>;
+    return *p;
+}
+
+}  // namespace
+
+extern "C" int gfxstream_va_drain_process_cleanup(void) {
+    auto* r = impl();
+    if (!r) return 0;
+    r->waitForProcessCleanup();
+    return 1;
+}
+
+extern "C" void gfxstream_va_pause_render_threads(void) {
+    if (auto* r = impl()) r->pauseRenderThreadsPreSave();
+}
+
+extern "C" int gfxstream_va_wait_snapshot_steps(uint64_t deadlineUs) {
+    auto* r = impl();
+    return r ? (r->waitForSnapshotSteps(deadlineUs) ? 1 : 0) : 0;
+}
+
+extern "C" int gfxstream_va_save(void* stream, const char* textureFile, uint64_t* textureBytes) {
+    auto* r = impl();
+    if (!r || !stream || !textureFile) return 0;
+    FILE* f = fopen(textureFile, "wb");
+    if (!f) return 0;
+    auto saver = std::make_shared<android::snapshot::TextureSaver>(
+        StdioStream(f, StdioStream::kOwner));
+    android::snapshot::ITextureSaverPtr ptr = saver;
+    r->save(static_cast<android::base::Stream*>(stream), ptr);
+    saver->done();
+    if (textureBytes) *textureBytes = saver->diskSize();
+    return saver->hasError() ? 0 : 1;
+}
+
+extern "C" int gfxstream_va_load(void* stream, const char* textureFile) {
+    auto* r = impl();
+    if (!r || !stream || !textureFile) return 0;
+    FILE* f = fopen(textureFile, "rb");
+    if (!f) return 0;
+    gfxstream_va_release_texture_loader();
+    auto loader = std::make_shared<android::snapshot::TextureLoader>(
+        StdioStream(f, StdioStream::kOwner));
+    loaderRef() = loader;
+    android::snapshot::ITextureLoaderPtr ptr = loader;
+    const bool ok = r->load(static_cast<android::base::Stream*>(stream), ptr);
+    return (ok && !loader->hasError()) ? 1 : 0;
+}
+
+extern "C" void gfxstream_va_drain_sync_thread(void) {
+    if (auto* t = gfxstream::SyncThread::get()) t->drainForSnapshot();
+}
+
+extern "C" void gfxstream_va_resume_all(void) {
+    if (auto* r = impl()) r->resumeAll();
+}
+
+extern "C" int gfxstream_va_repost(void) {
+    auto* fb = gfxstream::FrameBuffer::getFB();
+    return (fb && fb->repost()) ? 1 : 0;
+}
+
+extern "C" size_t gfxstream_va_num_render_threads(void) {
+    auto* r = impl();
+    return r ? r->numChannels() : 0;
+}
+
+extern "C" void gfxstream_va_finish_texture_loading(void) {
+    auto& loader = loaderRef();
+    if (loader) {
+        loader->join();  // every texture restored (lazy loads are done too)
+        loader.reset();
+    }
+}
+
+extern "C" void gfxstream_va_release_texture_loader(void) {
+    auto& loader = loaderRef();
+    if (loader) {
+        loader->interrupt();
+        loader->join();
+        loader.reset();
+    }
+}
