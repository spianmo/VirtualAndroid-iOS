diff --git a/host/ExitGate.h b/host/ExitGate.h
new file mode 100644
index 0000000..46ed117
--- /dev/null
+++ b/host/ExitGate.h
@@ -0,0 +1,64 @@
+// VirtualAndroid: process-exit gate for gfxstream worker threads.
+//
+// Embedders that host gfxstream in a long-lived process (QEMU, an iOS app)
+// may exit() while render/cleanup/sync threads are still busy. exit() then
+// runs the static destructors of ANGLE and of this library concurrently with
+// those threads, which corrupts the heap. The embedder calls freeze() from an
+// atexit handler that runs before those destructors: from then on every
+// thread parks at its next unit of work, and freeze() waits (bounded) for the
+// units already in flight to finish.
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <thread>
+
+namespace gfxstream {
+namespace exit_gate {
+
+inline std::atomic<bool> gFrozen{false};
+inline std::atomic<int> gBusy{0};
+
+[[noreturn]] inline void park() {
+    for (;;) std::this_thread::sleep_for(std::chrono::hours(1));
+}
+
+// Wrap one unit of work (a decoded batch, a cleanup item, a sync command).
+// Never nest scopes on one thread.
+class Scope {
+  public:
+    Scope() {
+        gBusy.fetch_add(1);
+        if (gFrozen.load()) {
+            gBusy.fetch_sub(1);
+            park();
+        }
+    }
+    ~Scope() { gBusy.fetch_sub(1); }
+    Scope(const Scope&) = delete;
+    Scope& operator=(const Scope&) = delete;
+};
+
+// For polling loops inside a Scope: once frozen, leave the busy count and park.
+inline void yieldPoint() {
+    if (gFrozen.load()) {
+        gBusy.fetch_sub(1);
+        park();
+    }
+}
+
+// Returns how many units were in flight when frozen; *drained tells whether
+// they all finished within timeoutMs.
+inline int freeze(int timeoutMs, bool* drained) {
+    gFrozen.store(true);
+    const int busy = gBusy.load();
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(timeoutMs);
+    while (gBusy.load() > 0 && std::chrono::steady_clock::now() < deadline) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    if (drained) *drained = gBusy.load() == 0;
+    return busy;
+}
+
+}  // namespace exit_gate
+}  // namespace gfxstream
